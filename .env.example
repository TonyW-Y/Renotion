# Copy to .env.local and fill in to enable accounts and cloud projects.
# Without these, Renotion runs fully offline (projects stay in the browser).
#
# Supabase dashboard → Project Settings → API Keys (publishable key) and the
# project URL. The publishable key is safe in the browser: every table is
# protected by Row Level Security (see supabase/migrations).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
